###################################################################
#### PCA visualizer from PCA produced by plink ####################
###################################################################
### we need .eigenvec output from plink pca, and popmap ###########

library(ggplot2)
library(plotly)
library(dplyr)
library(stringr)
library(RColorBrewer)
library (svglite)

##################################################################
pca <- read.table("plink.eigenvec", header = FALSE)
colnames(pca)[1:5] <- c("FID", "IID", "PC1", "PC2", "PC3")

popmap <- read.table("popmap.txt", header = FALSE, stringsAsFactors = FALSE)
colnames(popmap) <- c("IID", "Population")

# to merge PCA and population info
pca <- merge(pca, popmap, by = "IID")

#if we want to automatically generate colours for populations
pop_names <- unique(pca$Population)
n_pop <- length(pop_names)

if(n_pop <= 12){
  pop_colors <- setNames(brewer.pal(n_pop, "Set3"), pop_names)
} else {
  pop_colors <- setNames(scales::hue_pal()(n_pop), pop_names)
}

##scales::hue_pal()(20)  # 20 distinct colors - Set3 has only 12 colours

