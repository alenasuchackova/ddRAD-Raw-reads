# get explained variability
eigvals <- scan("plink.eigenval")
var_explained <- round(eigvals / sum(eigvals) * 100)
var_explained


p <- ggplot(pca, aes(x = PC1, y = PC2, fill = Population)) +
  geom_point(shape = 21, color = "black", size = 3, alpha = 0.8, stroke = 0.5) +
  scale_fill_manual(values = pop_colors) +
  theme_minimal(base_size = 14) +
  labs(
    title = "PCA (PLINK)",
    x = paste0("PC1 (", var_explained[1], "%)"),
    y = paste0("PC2 (", var_explained[2], "%)"),
    fill = "Population"
  )

print (p)

ggsave("PCA.png", plot = p, width = 10, height = 8, dpi = 150)
ggsave("PCA.svg", plot = p, width = 10, height = 8, dpi = 300, device = "svg")
ggsave("PCA.pdf", plot = p, width = 10, height = 8, dpi = 300, device = "pdf")

##############################################################
#### interactive 3D plot of 3 axes ###########################
##############################################################

plot_ly(
  pca,
  x = ~PC1,
  y = ~PC2,
  z = ~PC3,
  color = ~Population,
  colors = pop_colors,
  type = "scatter3d",
  mode = "markers",
  marker = list(size = 4)
) %>%
  layout(
    scene = list(
      xaxis = list(title = "PC1"),
      yaxis = list(title = "PC2"),
      zaxis = list(title = "PC3")
    ),
    legend = list(title = list(text = "Population"))
  )




