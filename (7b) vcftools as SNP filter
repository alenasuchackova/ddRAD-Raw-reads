# Alternative filtering to plink
# uses .vcf output from populations
# very quick, can run on frontend

module add vcftools

vcftools --vcf [path to input .vcf] \
--out output \
--max-missing 0.8 --maf 0.05 --hwe 0.001 --thin 1000 --minDP 5 --recode \
--remove remove_list.txt

# --max-missing 0.8 - sites are present in at least 80 % of individuals
# --maf 0.05 - keeping SNPs with minor allele frequency of greater or equal 5 %
# --hwe 0.001 - testing on the Hardy-Weinberg Equilibrium on p values of 0.001
# --thin 1000 - reduces linkage by keeping one SNP per 1000 base pairs
# --minDP 5 - keeps SNPs with a sequencing depth larger than 5X

# remove - removes individuals from a list (generated after checking for --missing-indv) (!no need to re-run gstacks)
## vcftools --vcf [] --output [] --missing-indv

##To change to plink: we need to generate .bed files
# denovo generated .vcf files have problems with chromosome names - they are only numbers, exceeding human chromosome numbers
# we need to change them to a text, so that plink can --allow-extra-chr

awk 'BEGIN{OFS="\t"} /^#/ {print; next} {$1="locus_"$1; print}' input.vcf > fixed.vcf

plink --vcf fixed.vcf --allow-extra-chr --make-bed --out [] --double-id
# --double-id if there are multiple underscores in my sample names


